# SideShift — environment variables
# Copy to `.env.local` and fill in values from your Supabase project settings.
# NEVER commit the real `.env.local`.

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose to the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Do not prefix with NEXT_PUBLIC_ and never
# ship it to the client. Used for admin/seeding tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
